# config.env — example / reference
#
# template-setup/setup.sh copies this to config.env at the repo root on first run
# and fills it in interactively. You can also copy it by hand and edit.
#
# config.env is the SINGLE source of truth. It is read by:
#   app/vite.config.ts                          (build-time __APP_CONFIG__)
#   infrastructure/lib/infrastructure-stack.ts  (at module load)
#   infrastructure/deploy.sh, app/deploy.sh
#
# IMPORTANT: keep comments on their own lines. None of the three parsers strip
# inline trailing comments, so `KEY=value  # note` yields the value *and* the
# note.
#
# config.env is gitignored. Never commit it — it holds the admin password.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# SITE_NAME is an input to setup.sh only; the domains below are derived from it
# as <SITE_NAME>.<DNS_HOSTED_ZONE> and <SITE_NAME>-qa.<DNS_HOSTED_ZONE>.
SITE_NAME=reader
SITE_TITLE=Reader
SITE_DOMAIN=reader.example.com
SITE_DOMAIN_QA=reader-qa.example.com

# Derived by setup.sh: SITE_DOMAIN with dots replaced by dashes.
SITE_BUCKET=reader-example-com
SITE_BUCKET_QA=reader-qa-example-com

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_SSO_PROFILE=123456789012_AdministratorAccess

# Cost allocation tag applied to every resource the stack creates.
BILLING_TAG=rssnetwork

# ---------------------------------------------------------------------------
# Route53
# ---------------------------------------------------------------------------
# A hosted zone for a domain you control. The stack creates the A records and
# an ACM certificate itself; it does not import an existing certificate.
R53_HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
DNS_HOSTED_ZONE=example.com

# ---------------------------------------------------------------------------
# Feed daemon
# ---------------------------------------------------------------------------
# EventBridge schedule for the RSS poll. Drives Lambda invocation cost.
# Rendered into stage-config.json by setup.sh.
RSS_SCHEDULE=rate(1 hour)

# ---------------------------------------------------------------------------
# Admin user
# ---------------------------------------------------------------------------
# The Cognito user created on first deploy. infrastructure/deploy.sh sets the
# password permanently on that first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Written by infrastructure/deploy.sh — leave empty
# ---------------------------------------------------------------------------
# Captured from stack outputs on first deploy. Once recorded, a changed value on
# a later deploy means CloudFormation replaced the resource, which deploy.sh
# treats as an error rather than silently accepting.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_IDENTITY_POOL_ID=
COGNITO_DOMAIN=
CF_DISTRIBUTION_ID=
CF_DISTRIBUTION_ID_QA=
